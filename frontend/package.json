{
  "name": "ytsbyai-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "test:security": "vitest security.test.ts",
    "test:performance": "vitest performance.test.ts",
    "test:offline": "vitest offline.test.ts",
    "test:error-boundary": "vitest ErrorBoundary.test.tsx",
    "test:all": "vitest run",
    "type-check": "tsc --noEmit",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",
    "performance:analyze": "ANALYZE=true npm run build",
    "performance:lighthouse": "lighthouse http://localhost:3000 --output html --output-path ./lighthouse-report.html",
    "pwa:validate": "pwa-asset-generator ./public/icon-512x512.png ./public -i ./public/manifest.json",
    "offline:test": "npm run build && http-server .next -p 3000",
    "preview": "npm run build && npm run start",
    "clean": "rm -rf .next out dist coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@stripe/stripe-js": "^2.2.0",
    "autoprefixer": "^10.0.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "firebase": "^11.10.0",
    "framer-motion": "^10.16.5",
    "lucide-react": "^0.294.0",
    "next": "^14.2.30",
    "next-themes": "^0.4.6",
    "postcss": "^8",
    "posthog-js": "^1.96.1",
    "react": "^18",
    "react-dom": "^18",
    "react-firebase-hooks": "^5.1.1",
    "react-player": "^3.2.0",
    "react-speech-recognition": "^3.10.0",
    "react-toastify": "^9.1.3",
    "swr": "^2.2.4",
    "tailwind-merge": "^2.0.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitejs/plugin-react": "^4.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^8",
    "eslint-config-next": "14.0.3",
    "http-server": "^14.1.1",
    "jsdom": "^23.0.1",
    "lighthouse": "^12.8.0",
    "prettier": "^3.0.3",
    "pwa-asset-generator": "^8.0.5",
    "tailwindcss-animate": "^1.0.7",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
